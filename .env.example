# IP LAN của Jetson mà trình duyệt dùng để kết nối WebRTC ICE.
NVC_LAN_IP=

# Cổng public của aggregator khi bật Compose profile `aggregator`.
AGGREGATOR_PORT=8100
AGGREGATOR_UID=1000
AGGREGATOR_GID=1000

# Mỗi Jetson dùng một ID khác nhau và trỏ tới máy đang chạy Aggregator.
NVC_JETSON_ID=jetson-a
# Ví dụ: ws://192.168.1.100:8100/ws/ingest
NVC_AGGREGATOR_WS_BASE_URL=
NVC_AGGREGATOR_RECONNECT_SECONDS=2

# Thử nghiệm TensorRT: build engine trong backend/weights/tensorrt rồi bật hai biến.
NVC_DEPTH_BACKEND=pytorch
NVC_TENSORRT_ENGINE_PATH=
